{
  "name": "@grapher/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./png": {
      "types": "./dist/png.d.ts",
      "default": "./dist/png.js"
    },
    "./system-font": {
      "types": "./dist/system-font.d.ts",
      "default": "./dist/system-font.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.js"
  }
}
